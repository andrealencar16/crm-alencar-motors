# Server-only configuration. Dealer ID is not a credential.
# Prepared locally only; this file does not activate HTTP processing or persistence.
REVENDAMAIS_DEALER_ID=9325
REVENDAMAIS_INGESTION_ENABLED=false
# Retired: the provider id is a delivery-attempt ID. Do not enable; code ignores it.
